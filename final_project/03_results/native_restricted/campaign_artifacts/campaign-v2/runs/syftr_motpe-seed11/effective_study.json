{
  "name": "rm-local-common-evaluator",
  "dataset": {
    "xname": "hotpotqa_hf",
    "storage_partitions": [
      "sample",
      "train",
      "test",
      "holdout"
    ],
    "partition_map": {
      "sample": "sample",
      "train": "train",
      "test": "test",
      "holdout": "holdout"
    },
    "load_examples_timeout_s": 3600,
    "load_grounding_data_timeout_s": 3600,
    "eval_user_template": "\n## User Query\n{query}\n\n## Reference Answer\n{reference_answer}\n\n## Generated Answer\n{generated_answer}\n",
    "subset": "train_hard",
    "description": "This dataset is a vast collection of all kind of information that you can find on Wikipedia. It can be used, for instance, to retrieve straightforward facts from one or more documents, compare two entities based on shared attributes, identify relationships, roles, or attributes of entities, reason about dates, timelines, or chronological order, determine geographical relationships or locations, explain causes or sequences of events or processes, synthesize facts from multiple documents to infer answers, and validate or refute premises in the context of the question."
  },
  "evaluation": {
    "mode": "single",
    "llm_names": [
      "rm-qwen25-7b-q4"
    ],
    "raise_on_exception": false,
    "use_tracing_metrics": false,
    "min_reporting_success_rate": 0.5,
    "eval_type": "correctness",
    "eval_system_template": "You evaluate factual correctness against the supplied reference answer.\nDo not use outside knowledge. Score 1 if irrelevant, 2 or 3 if relevant but incorrect,\nand 4 or 5 if correct and consistent with the reference. Return only a JSON object:\n{\"score\": 4, \"reasoning\": \"The answer agrees with the reference.\"}",
    "score_threshold": 4.0
  },
  "reuse_study": true,
  "recreate_study": false,
